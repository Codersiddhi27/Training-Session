TASK-1
WAP to print the factorial of given number without using recursion
//factorial without recursion
#include<stdio.h>
int main(){
    int num;
    double fact=1;
    printf("enter the number to get factorial: ");
    scanf("%d",&num);
    while(num<0){
        printf("factorial can't be calculated of negative numbers");
        return 0;
    }
    while(num==0 || num==1){
        printf("factorial of entered number is 1");
        return 0;
    }
   for(int i=2;i<=num;i++){
       fact=fact*i;
   }
   printf("factorial of given number is %lf",fact);
   return 0;
}
TASK-2
WAP to print the factorial of given number using recursion
//factorial using recursion
#include<stdio.h>
long long factorial(int n){
    if(n<0){
       printf("factorial cannot be determined");
       return -1;
    }
    if(n==1 ||n==0){
        return 1;
    }
    return n*factorial(n-1);
}
int main(){
    int n;
    printf("enter the value of n: ");
    scanf("%d",&n);

    long long result=factorial(n);
    if(result != -1){
        printf("factorial of %d is %lld",n,result);
    }
    return 0;
}
