write c program for linear search.
#include <stdio.h>

int main() {
    int size;

    printf("enter the size:\n");
    scanf("%d", &size);

    int arr[size];

    printf("enter value for array\n");
    for (int i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    int target;
    printf("Enter target value:\n");
    scanf("%d", &target);   // yahi input ka part hai

    int found = 0;

    for (int i = 0; i < size; i++) {
        if (arr[i] == target) {
            printf("Index of target: %d\n", i);
            found = 1;
            break;
        }
    }

    if (found == 0) {
        printf("element not found\n");
    }

    return 0;
}
