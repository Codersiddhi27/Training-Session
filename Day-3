Write c program to count the number of vowels in a given words:
// count the no. of vowels in a given string
//(note:- there must not be any restriction on no. of characters)
#include<stdio.h>
int main(){
    char str[100],ch;
    int i,count=0;
    printf("enter the word: ");
    scanf("%[^\n]",str);
    for(i=0; str[i] != '\0'; i++){
        ch=str[i];
        if(ch >= 'A' && ch <= 'Z'){
        ch = ch+ 32;}
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u')
        {
            count++;
        }
        
    }
    printf("%d is the total vowel in given word", count);
    return 0;
}


Write c program to count the number of consonent in a given word:
// count the no. of consonant in a given string
//(note:- there must not be any restriction on no. of characters)
#include<stdio.h>
#include<string.h>
int main(){
    char str[100],ch;
    int i,count=0;
    printf("enter the word: ");
    scanf("%[^\n]",str);
    for(i=0; str[i] != '\0'; i++){
        ch=str[i];
        if(ch >= 'A' && ch <= 'Z'){
        ch = ch+ 32;
        }
        if(ch!='a'&& ch!='e'&& ch!='i'&& ch!='o'&& ch!='u' && ch>='a' && ch<='z')
        {
            count++;
        }
        
    }
    printf("%d is the total consonant in given word", count);
    return 0; 
}


