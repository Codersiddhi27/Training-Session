TASK-1
Write C program to check whether the number is palindrome or not:-
 //palindrome number checking
#include <stdio.h>
int main(){
    int num,rem,rev=0;
    printf("enter the value of num: ");
    scanf("%d",&num);
    int original=num;
    while(num>0){
        rem=num%10;
        rev=rev*10+rem;
        num=num/10;
    }
    if(original==rev){
        printf("Entered value is palindrome");
    }else{
        printf("Entered value is not palindrome");
    }
}


TASK-2
Write Cprogram to check whether the given string is palindrome or not:-
//check the string is whether palindrome or not
#include <stdio.h>
int main(){
    char str[100];
    int j=0,i=0;
    int flag=0;
    printf("Enter the word: ");
    scanf("%s",&str);
    while(str[j]!='\0'){
        
        j++;
    }
    j--;
    while(i<j){
        if(str[i]!=str[j]){
            flag=1;
            break;
        }
        i++;
        j--;
    }
    if(flag==0){
        printf("Given word is palindrome");
    }else{
        printf("Given word is not palindrome");
    }
    return 0;
}


